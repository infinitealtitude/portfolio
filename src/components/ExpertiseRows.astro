---
import type { Portfolio } from '../lib/content';
import { localHref } from '../lib/site';

interface Props {
  items: Portfolio['expertise'];
}

const { items } = Astro.props;
---
{items.map(item => (
  <div class="expertise-row">
    <h3>{item.category}</h3>
    <div>
      <ul class="expertise-list" role="list">{item.capabilities.map(skill => <li>{skill}</li>)}</ul>
      {item.tools && <p class="expertise-tools"><strong>Tools</strong> {item.tools.join(' · ')}</p>}
      <p class="expertise-evidence">{item.evidence.map(link => <a href={localHref(link.href)}>{link.label}</a>)}</p>
    </div>
  </div>
))}
